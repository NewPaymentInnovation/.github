# ─── Database ─────────────────────────────────────────────────────────────────
SETTLE_PROCESSING_DATABASE_URL=postgresql://postgres:password@localhost:5432/settle_processing

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
S3_BUCKET_NAME=settle-processing-uploads

# SQS Queue URLs (use localstack URLs for local dev)
SQS_INGEST_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789/settle-ingest
SQS_CALC_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789/settle-calc
SQS_DLQ_URL=https://sqs.eu-west-1.amazonaws.com/123456789/settle-dlq

# ─── PostHog ──────────────────────────────────────────────────────────────────
POSTHOG_API_KEY=phc_your_posthog_key_here
POSTHOG_HOST=https://app.posthog.com

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
